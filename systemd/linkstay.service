[Unit]
Description=linkstay Network Monitor with Auto-Shutdown
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# Runtime
Type=notify
NotifyAccess=main
SyslogIdentifier=linkstay
StandardOutput=journal
StandardError=journal

ExecStart=/usr/local/bin/linkstay

# TimeoutStartSec bounds how long systemd waits for the READY=1 notification
# sent from log_startup(); WatchdogSec is a separate recurring deadline that
# only starts counting once the service is considered started (after READY).
# The two do not race: linkstay sends READY during initialization, well
# before the event loop schedules the first WATCHDOG=1 notification.
TimeoutStartSec=30
TimeoutStopSec=10
WatchdogSec=30

# Restart
Restart=on-failure
RestartSec=10

# Configuration
Environment="LINKSTAY_TARGET=1.1.1.1"
Environment="LINKSTAY_INTERVAL=10"
Environment="LINKSTAY_THRESHOLD=5"
Environment="LINKSTAY_TIMEOUT=3000"
Environment="LINKSTAY_POWEROFF=false"
Environment="LINKSTAY_LOG_LEVEL=info"
Environment="LINKSTAY_SYSTEMD=true"

# Privilege containment
User=root
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_RAW

# Filesystem isolation
ProtectSystem=strict

# Network and syscall restrictions
# AF_NETLINK is intentionally not included: linkstay only opens raw ICMP
# sockets (AF_INET/AF_INET6) and an AF_UNIX datagram socket for sd_notify;
# it never resolves DNS/NSS and has no other use for netlink sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io @process

# Resource limits
MemoryMax=50M
TasksMax=10
OOMScoreAdjust=-100

[Install]
WantedBy=multi-user.target
