[Unit]
Description=LinkStay network monitor and auto-shutdown service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# Runtime
Type=notify
NotifyAccess=main
SyslogIdentifier=linkstay
StandardInput=null
StandardOutput=null
StandardError=journal

ExecStart=@BINDIR@/linkstay

# READY=1 is sent before the first probe, so TimeoutStartSec does not include
# LINKSTAY_START_DELAY. WatchdogSec is a separate recurring deadline that starts
# after READY=1; linkstay arms WATCHDOG=1 while waiting for the first probe.
TimeoutStartSec=30
TimeoutStopSec=10
WatchdogSec=30

# Restart
Restart=on-failure
RestartSec=10

# Configuration. The unit defaults can be overridden per-host in
# /etc/linkstay.conf, which is read after these Environment= lines.
Environment="LINKSTAY_TARGET=1.1.1.1"
Environment="LINKSTAY_INTERVAL=10s"
Environment="LINKSTAY_THRESHOLD=5"
Environment="LINKSTAY_TIMEOUT=3000ms"
Environment="LINKSTAY_START_DELAY=30s"
Environment="LINKSTAY_POWEROFF=true"
Environment="LINKSTAY_LOG_LEVEL=info"
EnvironmentFile=-@CONFIG_PATH@

# Privilege containment
User=root
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_RAW

# Filesystem, kernel, and identity isolation
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
PrivateTmp=true
UMask=0077
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true

# Network and syscall restrictions
# AF_NETLINK is intentionally not included: linkstay only opens raw ICMP
# sockets (AF_INET/AF_INET6) and an AF_UNIX datagram socket for sd_notify;
# it never resolves DNS/NSS and has no other use for netlink sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io @process

# Resource limits
MemoryMax=50M
TasksMax=10
OOMScoreAdjust=-100

[Install]
WantedBy=multi-user.target
